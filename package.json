{
  "name": "vienotais-zemes-registrs",
  "version": "0.1.0",
  "private": true,
  "description": "Vienotais Zemes Reģistrs — atvērto datu zemes vienību pārlūks: uzklikšķiniet uz kartes un saņemiet visu par kadastra numuru",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "setup:data": "tsx server/indexCadastre.ts",
    "prewarm": "tsx server/prewarm.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
